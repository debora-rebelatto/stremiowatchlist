# ==========================================
# ENVIRONMENT & SAFETY CONFIGURATION
# ==========================================
# Environment name: development | production | test (defaults to development locally)
APP_ENV=development

# Set to "memory" to force 100% in-memory mode without any database connection
# DB_MODE=memory

# Safety guard: local development refuses remote *.supabase.co databases unless explicitly set to true
ALLOW_REMOTE_DB_IN_DEV=false

# ==========================================
# SUPABASE DATABASE CONFIGURATION
# ==========================================
# For local testing with Docker (recommended), run `npm run db:start`.
# It automatically generates `.env.development.local` pointing to http://127.0.0.1:54321.
#
# In Vercel Dashboard, scope Production SUPABASE_URL, SUPABASE_KEY, and ENCRYPTION_KEY
# strictly to the "Production" environment (uncheck "Preview") so Preview deploys never touch Prod.

# Supabase Project URL (Local Docker: http://127.0.0.1:54321 | Cloud: https://<ref>.supabase.co)
SUPABASE_URL=http://127.0.0.1:54321

# Supabase API Key (supports sb_secret_*, service_role, sb_publishable_*, or anon keys)
SUPABASE_KEY=your-local-or-staging-supabase-key

# Optional AES-256 master key for encrypting Stremio auth tokens (keep distinct per environment!)
ENCRYPTION_KEY=local-dev-encryption-key-not-for-production

# ==========================================
# ANALYTICS & ADMIN
# ==========================================
# Leave VITE_POSTHOG_KEY empty in local development to avoid polluting production analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional comma-separated list of admin account emails
ADMIN_EMAIL=test-admin@example.com

# ==========================================
# TMDB (THE MOVIE DATABASE) - TRENDING HERO
# ==========================================
# Optional free API Key from themoviedb.org for live trending movies in Hero banner
TMDB_API_KEY=your_tmdb_api_key_v3

# ==========================================
# PRIVACY & TRACKING EXCLUSION (OPT-OUT)
# ==========================================
# Comma-separated list of account emails or user IDs excluded from PostHog, Vercel Analytics, and DB events:
EXCLUDED_TRACKING_EMAILS=account1@gmail.com,account2@gmail.com
VITE_EXCLUDED_TRACKING_EMAILS=account1@gmail.com,account2@gmail.com
EXCLUDED_TRACKING_USER_IDS=uuid-1,uuid-2
VITE_EXCLUDED_TRACKING_USER_IDS=uuid-1,uuid-2
