{
  "name": "stremio-watchlist-1080p",
  "version": "1.0.0",
  "description": "Stremio addon with personal watchlist and good quality movie tracking (Good Quality Tracker)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npm run build:server && concurrently \"node --watch server.js\" \"vite\"",
    "dev:server": "npm run build:server && node --watch server.js",
    "dev:client": "vite",
    "build:server": "node scripts/build-server.js",
    "build": "npm run build:server && vite build",
    "vercel-build": "npm run build:server && vite build",
    "preview": "vite preview",
    "test": "jest --forceExit",
    "test:server": "jest tests/server",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck:client": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start && node scripts/db-sync-env.js",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:env": "node scripts/db-sync-env.js",
    "db:reset": "node scripts/db-reset-safe.js",
    "db:seed": "node scripts/db-seed-safe.js",
    "dev:memory": "node scripts/dev-memory.js"
  },
  "keywords": [
    "stremio",
    "stremio-addon",
    "watchlist",
    "good-quality-tracker",
    "movies"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.72.0",
    "posthog-js": "^1.450.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/vite": "^4.3.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
